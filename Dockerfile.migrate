FROM --platform=$BUILDPLATFORM golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039 AS builder
ARG TARGETOS
ARG TARGETARCH
ENV CGO_ENABLED=0
WORKDIR /build
COPY go.mod go.sum ./
COPY migration ./migration
COPY cmd/migrate ./cmd/migrate
RUN GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-arm64} go build -mod=readonly -trimpath -ldflags="-s -w" -o /newapi-migrate ./cmd/migrate

FROM debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /newapi-migrate /usr/local/bin/newapi-migrate
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
USER 1000:1000
CMD ["/usr/local/bin/newapi-migrate"]
